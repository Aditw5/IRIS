# Copy this file to .env on the deployment host and replace every placeholder.
# Never commit the resulting .env file.

IMAGE_TAG=latest

APP_KEY=base64:replace-with-generated-laravel-key
APP_URL=https://iris.example.com
DB_PASSWORD=replace-with-database-password

SOCKET_SERVER_SECRET=replace-with-a-long-random-shared-secret
CORS_ORIGIN=https://iris.example.com

VITE_API_BASE_URL=/service
# Leave empty to use the browser's current origin and Nginx /socket.io/ proxy.
VITE_SOCKET_URL=
VITE_SOCKET_ON=true

